# 一个很小的 GPT：在几首唐诗上训练字符级的 Transformer 语言模型，然后让它“写诗”
#
#     aether run examples/gpt.ae          有 GPU 时使用 GPU
#     aether run examples/gpt.ae cpu
import sys
import time
import tensor
import tensor.nn as nn
import tensor.optim as optim
from tensor import Tensor

const TEXT = ("床前明月光，疑是地上霜。举头望明月，低头思故乡。" +
    "春眠不觉晓，处处闻啼鸟。夜来风雨声，花落知多少。" +
    "白日依山尽，黄河入海流。欲穷千里目，更上一层楼。" +
    "红豆生南国，春来发几枝。愿君多采撷，此物最相思。" +
    "千山鸟飞绝，万径人踪灭。孤舟蓑笠翁，独钓寒江雪。" +
    "空山不见人，但闻人语响。返景入深林，复照青苔上。" +
    "松下问童子，言师采药去。只在此山中，云深不知处。" +
    "向晚意不适，驱车登古原。夕阳无限好，只是近黄昏。")

const BLOCK = 24      # 上下文长度
const EMBED = 64

class GPT(nn.Module):
    tok: nn.Embedding
    pos: nn.Embedding
    blocks: nn.Sequential
    norm: nn.LayerNorm
    head: nn.Linear

    def __init__(self, vocab: int):
        self.tok = nn.Embedding(vocab, EMBED)
        self.pos = nn.Embedding(BLOCK, EMBED)
        self.blocks = nn.Sequential(
            nn.TransformerEncoderLayer(EMBED, 4, dropout=0.1, causal=true),
            nn.TransformerEncoderLayer(EMBED, 4, dropout=0.1, causal=true),
        )
        self.norm = nn.LayerNorm(EMBED)
        self.head = nn.Linear(EMBED, vocab)

    # idx：[批次, 长度] 的字符下标 -> [批次, 长度, 字符表大小] 的 logits
    def forward(self, idx: Tensor) -> Tensor:
        t = idx.size(1)
        x = self.tok(idx) + self.pos(tensor.arange(t))
        return self.head(self.norm(self.blocks(x)))

device = sys.argv[1] if len(sys.argv) > 1 else ("gpu" if tensor.gpu_available() else "cpu")
tensor.set_default_device(device)
tensor.manual_seed(1)

chars = sorted(set(str(c) for c in TEXT))
index = {c: i for i, c in enumerate(chars)}
data = [index[str(c)] for c in TEXT]
print(f"语料 {len(data)} 个字，字符表 {len(chars)} 个字，设备 {device}")

model = GPT(len(chars))
print(f"参数个数：{model.num_parameters()}")
opt = optim.AdamW(model.parameters(), lr=0.003, weight_decay=0.01)
loss_fn = nn.CrossEntropyLoss()

# 随机取一批长度为 BLOCK 的片段：输入是片段，目标是向后错一个字的片段
def batch(size: int) -> (Tensor, Tensor):
    starts = tensor.randint(0, len(data) - BLOCK - 1, [size]).tolist()
    xs: list[int] = []
    ys: list[int] = []
    for s in starts:
        i = int(s)
        xs.extend(data[i:i + BLOCK])
        ys.extend(data[i + 1:i + BLOCK + 1])
    return (tensor.from_ints(xs, [size, BLOCK]), tensor.from_ints(ys, [size * BLOCK]))

start = time.time()
model.train()
for step in range(1, 601):
    x, y = batch(32)
    logits = model(x)
    loss = loss_fn(logits.reshape(32 * BLOCK, len(chars)), y)
    opt.zero_grad()
    loss.backward()
    nn.clip_grad_norm_(model.parameters(), 1.0)
    opt.step()
    if step % 150 == 0:
        print(f"第 {step} 步：损失 {loss.item():.3f}")
tensor.synchronize()
print(f"训练用时 {time.time() - start:.1f} 秒")

# 逐字生成：每次用最后 BLOCK 个字预测下一个字的概率，再按概率抽样
def generate(prompt: str, n: int, temperature: float = 0.8) -> str:
    model.eval()
    ids = [index[str(c)] for c in prompt]
    with tensor.no_grad():
        for _ in range(n):
            ctx = ids[max(0, len(ids) - BLOCK):]
            logits = model(tensor.from_ints(ctx, [1, len(ctx)]))
            last = logits[0][len(ctx) - 1]
            probs = (last / temperature).softmax(dim=0)
            ids.append(int(tensor.multinomial(probs).item()))
    return "".join(chars[i] for i in ids)

for prompt in ["床前", "春来", "白日", "山中"]:
    print(generate(prompt, 22))
