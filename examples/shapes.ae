# 面向对象：抽象类、继承与虚方法、接口（结构化实现）、属性、运算符重载
import math

interface Drawable:
    def draw(self) -> str

abstract class Shape:
    name: str = "图形"

    abstract def area(self) -> float
    abstract def perimeter(self) -> float

    def summary(self) -> str:
        # area() 在运行时分派到具体子类的实现
        return f"{self.name:<4} 面积={self.area():8.3f}  周长={self.perimeter():7.3f}"

class Circle(Shape):
    radius: float

    def __init__(self, radius: float):
        self.name = "圆"
        self.radius = radius

    override def area(self) -> float:
        return math.pi * self.radius ** 2

    override def perimeter(self) -> float:
        return 2.0 * math.pi * self.radius

    def draw(self) -> str:
        return "○"

class Rect(Shape):
    w: float
    h: float

    def __init__(self, w: float, h: float):
        self.name = "矩形"
        self.w = w
        self.h = h

    override def area(self) -> float:
        return self.w * self.h

    override def perimeter(self) -> float:
        return 2.0 * (self.w + self.h)

    # C# 风格的属性
    prop is_square -> bool:
        return self.w == self.h

    def draw(self) -> str:
        return "▭"

class Square(Rect):
    def __init__(self, side: float):
        super().__init__(side, side)
        self.name = "正方形"

    override def draw(self) -> str:
        return "□"

shapes: list[Shape] = [Circle(1.5), Rect(2.0, 3.5), Square(2.0)]
for s in shapes:
    print(s.summary())

biggest = shapes.max_by(s => s.area())
print("最大的是", biggest.name)

# 接口是结构化的：只要有 draw() 方法就满足 Drawable（像 Go 一样）
def render(items: list[Drawable]) -> str:
    return " ".join(d.draw() for d in items)

print(render([Circle(1.0), Rect(1.0, 2.0), Square(1.0)]))

for s in shapes:
    if s is Rect:
        print(f"{s.name} 是正方形吗？{s.is_square}")

# 值类型 struct + 运算符重载（C++ 风格）
struct Vec2:
    x: float
    y: float

    def __add__(self, o: Vec2) -> Vec2:
        return Vec2(self.x + o.x, self.y + o.y)

    def __sub__(self, o: Vec2) -> Vec2:
        return Vec2(self.x - o.x, self.y - o.y)

    def __mul__(self, k: float) -> Vec2:
        return Vec2(self.x * k, self.y * k)

    def __rmul__(self, k: float) -> Vec2:
        return Vec2(self.x * k, self.y * k)

    def dot(self, o: Vec2) -> float:
        return self.x * o.x + self.y * o.y

    prop length -> float:
        return math.sqrt(self.dot(self))

    def __str__(self) -> str:
        return f"({self.x:g}, {self.y:g})"

a = Vec2(3.0, 4.0)
b = Vec2(1.0, -2.0)
print(f"a={a} b={b} a+b={a + b} a-b={a - b} 2*a={2.0 * a} |a|={a.length}")
print("结构体按值比较：", a == Vec2(3.0, 4.0))
