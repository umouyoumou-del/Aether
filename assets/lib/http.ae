# http 模块：HTTP 服务器与客户端（基于 Go 的 net/http）
# 路由模式支持 Go 1.22 语法，例如 "/users/{id}"，用 req.param("id") 取值。

@go("*rthttp.HTTPRequest")
class Request:
    @go("Method") prop method -> str
    @go("Path") prop path -> str
    @go("URL") prop url -> str
    @go("Body") prop body -> str
    @go("Query") def query(self, name: str) -> str?
    @go("Param") def param(self, name: str) -> str?
    @go("Header") def header(self, name: str) -> str?
    @go("Form") def form(self, name: str) -> str?
    @go("JSON") def json(self) -> any

@go("*rthttp.HTTPResponse")
class Response:
    @go("Status") prop status -> int
    @go("Text") prop text -> str
    @go("Ok") prop ok -> bool
    @go("JSON") def json(self) -> any
    @go("Header") def header(self, name: str) -> str?
    @go("SetHeader") def set_header(self, name: str, value: str) -> Response

@go("rthttp.HTTPText") def text(body: str, status: int = 200) -> Response
@go("rthttp.HTTPHTML") def html(body: str, status: int = 200) -> Response
@go("rthttp.HTTPJSON") def json(value: any, status: int = 200) -> Response
@go("rthttp.HTTPStatus") def status(code: int, message: str = "") -> Response
@go("rthttp.HTTPRedirect") def redirect(url: str) -> Response

@go("*rthttp.HTTPServer", ctor="rthttp.NewHTTPServer")
class Server:
    def __init__(self)
    @go("Get") def get(self, pattern: str, handler: fn(Request) -> Response)
    @go("Post") def post(self, pattern: str, handler: fn(Request) -> Response)
    @go("Handle") def route(self, method: str, pattern: str, handler: fn(Request) -> Response)
    @go("Static") def static(self, prefix: str, dir: str)
    @go("Listen") def listen(self, addr: str = ":8080")
    @go("Start") def start(self, addr: str = ":0") -> str
    @go("Stop") def stop(self)
    @go("SetQuiet") def quiet(self, on: bool = true)

@go("rthttp.HTTPGet") def get(url: str, timeout: float = 30.0) -> Response
@go("rthttp.HTTPPost") def post(url: str, body: str, content_type: str = "application/json", timeout: float = 30.0) -> Response
