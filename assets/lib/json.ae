# json 模块：JSON 编码与解码
# loads 返回 any：对象是 dict[str, any]，数组是 list[any]，数字是 int 或 float。

@go("rtjson.JSONDumps") def dumps(value: any, indent: int = 0, sort_keys: bool = false) -> str
@go("rtjson.JSONLoads") def loads(text: str) -> any
@go("rtjson.JSONLoadsDict") def loads_dict(text: str) -> dict[str, any]
@go("rtjson.JSONLoadsList") def loads_list(text: str) -> list[any]
@go("rtjson.JSONValid") def valid(text: str) -> bool
