# os.read_text：Python Path(path).read_text(encoding=...) 的可观测语义——BOM（utf-8 保留 / utf-8-sig 去掉）、
# 严格 UTF-8（UnicodeDecodeError 的出错区间、原因与文案）、通用换行、编码名规范化与 LookupError。
# 期望输出（30_read_text.out）由 CPython 3.12 对同一批字节跑出来，不是手写。
import base64
import os

CASES: list[(str, str)] = [
    ("plain", "eyJhIjogMX0="),
    ("bom", "77u/eyJhIjogMX0="),
    ("crlf", "YQ0KYg1jCg=="),
    ("cjk", "5Lit5paH"),
    ("empty", ""),
    ("bad_start", "/3t9"),
    ("bad_start_mid", "YWKAY2Q="),
    ("c0", "wIA="),
    ("cont2", "eMNB"),
    ("cont3a", "5EFC"),
    ("cont3b", "5L1B"),
    ("overlong_e0", "4ICA"),
    ("surrogate_ed", "7aCA"),
    ("cont4a", "8EFBQQ=="),
    ("cont4b", "8J9BQQ=="),
    ("cont4c", "8J+YQQ=="),
    ("f4_high", "9JCAgA=="),
    ("f5", "9YCAgA=="),
    ("eod1", "b2vk"),
    ("eod2", "b2vkvQ=="),
    ("eod4_3", "b2vwn5g="),
    ("eod3_bad2", "b2vggA=="),
    ("bom_then_bad", "77u//w=="),
]
ENCODINGS: list[str] = ["utf-8", "UTF8", "utf_8", "U8", "utf-8-sig", "UTF-8-SIG", "utf8-sig", "latin-x"]


def hex_of(code: int) -> str:
    digits = "0123456789abcdef"
    if code == 0:
        return "0"
    out = ""
    n = code
    while n > 0:
        out = str(digits[n % 16]) + out
        n = n // 16
    return out


def render(s: str) -> str:
    parts: list[str] = []
    for ch in s:
        parts.append(hex_of(ord(ch)))
    return "[" + " ".join(parts) + "]"


for case in CASES:
    name, b64 = case
    os.write_bytes(name, base64.decode_bytes(b64))
for case in CASES:
    name, b64 = case
    encs: list[str] = ["utf-8", "utf-8-sig"]
    if name == "plain":
        encs = ENCODINGS
    for enc in encs:
        out = ""
        try:
            out = "OK " + render(os.read_text(name, enc))
        except Exception as e:
            out = "ERR " + type_name(e) + ": " + e.message
        print(name + " [" + enc + "] " + out)
