# 基础：变量、运算、字符串
x = 10
y = 3
print(x + y, x - y, x * y, x / y, x // y, x % y, x ** y)
print(-7 // 2, -7 % 2, 7 // -2, 7 % -2)
print(2.5 * 4, 10 / 4, 1 / 3)
print(0.1 + 0.2, 1e20, 1.5e-7, 100.0, 3.0)
a: float = 1
print(a, a + 1)
big = 1_000_000
print(big, 0xff, 0b1010, 0o17)
s = "以太 Aether"
print(len(s), s[0], s[-1], s[0:2], s[3:], s[::-1])
print(s.upper(), s.lower(), s.replace("Aether", "语言"))
print("a,b,,c".split(","), "  hi  ".strip(), "x".center(5, "*"))
print("-".join(["a", "b", "c"]), ", ".join(str(i) for i in range(4)))
name = "世界"
n = 42
pi = 3.14159265
print(f"你好 {name}! n={n:05d} pi={pi:.3f} {n:>6} {n:<4}| {n:^7}|")
print(f"{n=} {pi=:.2f} {name!r}")
print(f"{1234567.891:,.2f} {0.256:.1%} {255:x} {255:#b}")
c = 'A'
print(c, ord(c), chr(66), c + 1, 'z' - 'a')
print(str(42) + "!", int("123") + 1, float("2.5") * 2, int(3.99), int(-3.99))
print(round(2.5), round(3.5), round(2.675, 2), abs(-5), abs(-2.5))
print(min(3, 1, 2), max(3, 1, 2), min([4, 5, 1]), max("hello"))
print(true if 1 < 2 else false)
