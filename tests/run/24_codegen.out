—— 乘积与减法 ——
def f(x: float, y: float) -> float:
    return x * y - 3.0
—— 平方与立方换成乘法 ——
def f(x: float) -> float:
    return x * x * x + x * x
—— 商、负系数、倒数 ——
def f(x: float) -> float:
    return 1.0 / (x + 1.0) - 1.0 / x
—— 变量指数、sqrt ——
def f(x: float, y: float) -> float:
    return math.sqrt(x) + math.pow(x, y)
—— 公共子表达式只算一次 ——
def f(x: float) -> float:
    _t0 = math.sin(x)
    return math.exp(_t0) * _t0 + _t0
—— 展开后的多项式 ——
def f(a: float, b: float) -> float:
    return a * a * a + 3.0 * (a * a) * b + 3.0 * a * (b * b) + b * b * b
—— 常量表达式没有参数 ——
def f() -> float:
    return 2.5
—— 同一份表达式派生出的梯度函数 ——
