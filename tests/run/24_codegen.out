# 由 Aether codegen 生成，请勿手工编辑。
# 表达式：exp(x*y)
import math
import sys

def f(x: float, y: float) -> float:
    return math.exp(x * y)

def f_dx(x: float, y: float) -> float:
    return y * math.exp(x * y)

def f_dy(x: float, y: float) -> float:
    return x * math.exp(x * y)

_args: list[float] = [float(a) for a in sys.argv[1:]]
if len(_args) != 2:
    print("用法：f x y", file=sys.stderr)
    sys.exit(2)
_v = f(_args[0], _args[1])
print(f"{_v:.17g}")
_g0 = f_dx(_args[0], _args[1])
print(f"{_g0:.17g}")
_g1 = f_dy(_args[0], _args[1])
print(f"{_g1:.17g}")
—— 一行表达式文本 ——
(x + 1.0) * (x + 1.0) / (y - 2.0)
-2.0 * math.cos(x)
math.sqrt(x)
