# Python 常见写法：类型别名、:=、星号解包、切片赋值、内置函数作为函数值、__repr__ 等
import re

# ===== 类型别名 =====
type Graph = dict[str, list[(str, int)]]
type Pair[T] = (T, T)
type Grid[T] = list[list[T]]
type Counter2[K: Hashable] = dict[K, int]
type Callback = fn(int) -> str

class Point:
    x: int
    y: int = 0
    def norm1(self) -> int:
        return abs(self.x) + abs(self.y)

type P = Point

def neighbors(g: Graph, n: str) -> list[str]:
    return [v for v, _ in g.get(n, [])]

def swap[T](p: Pair[T]) -> Pair[T]:
    return (p[1], p[0])

g: Graph = {"a": [("b", 1), ("c", 2)]}
print(neighbors(g, "a"), neighbors(g, "z"), swap((1, 2)), swap(("x", "y")))
grid: Grid[int] = [[1, 2], [3, 4]]
cnt: Counter2[str] = {}
for w in "a b a".split():
    cnt[w] = cnt.get(w, 0) + 1
cb: Callback = n => "#" * n
empty = Graph()
empty["q"] = []
print(grid, cnt, cb(3), empty, P(5, 6).x)

def describe(v: any) -> str:
    match v:
        case P(x, y):
            return f"点 {x},{y}"
        case _:
            return "其它"
print(describe(Point(7, 8)), describe(3))

# ===== 内置函数、类型名、类型.方法 当作函数值 =====
words = ["banana", "Apple", "fig", "cherry"]
print(sorted(words, key=len), max(words, key=len), sorted(words, key=str.lower))
nums = list(map(int, "3 1 2".split()))
print(nums, list(map(str, nums)), list(filter(x => x > 1, nums)), ", ".join(map(str, range(4))))

def compose[A, B, C](f: fn(A) -> B, h: fn(B) -> C) -> fn(A) -> C:
    return x => h(f(x))
def identity[T](x: T) -> T:
    return x
inc = (x: int) => x + 1
pts = list(map(Point, [1, -2, 3]))
print(compose(inc, str)(41), nums.map(identity), pts.map(Point.norm1), list(map(ord, "ab")))
f: fn(str) -> int = len
r: fn(float) -> int = round
print(f("hello"), r(2.5), r(3.5))

# ===== := =====
xs = [1, 2, 3, 4, 5]
if (n := len(xs)) > 3:
    print(f"列表有 {n} 个元素")

lines = ["a", "bb", "", "ccc"]
i = 0
def next_line() -> str?:
    global i
    if i < len(lines):
        i += 1
        return lines[i - 1]
    return null
while (line := next_line()) != null:
    print(f"[{line}]", len(line))

for s in ["x=1", "nothing", "y=22"]:
    if m := re.match(r"(\w)=(\d+)", s):
        print(m.group(1), int(m.group(2)) * 2)

def sq(x: int) -> int:
    return x * x
ok = true
if ok and (big := sq(7)) > 10:
    print("平方", big)
print([y for x in [3, -1, 4] if (y := x * 10) > 0], (a := 3) + a)

# ===== 星号解包 =====
first, *mid, last = [10, 20, 30, 40]
head, *tail = "hey"
p1, *q1, r1 = (1, 2.5, 3.5, "end")
print(first, mid, last, head, tail, p1, q1, r1)
for h, *others in [[1, 2, 3], [4]]:
    print(h, others)
for k, (u, *vs) in enumerate([(1, 2, 3), (4, 5, 6)]):
    print(k, u, vs)
for c1, c2 in [[1, 2], [3, 4]]:
    print(c1 + c2)
try:
    e1, e2 = [1, 2, 3]
except ValueError as e:
    print("错误：", e)

# ===== 切片赋值与删除 =====
ys = [1, 2, 3, 4, 5, 6]
ys[1:3] = [20, 30, 35]
print(ys)
ys[::2] = [0, 0, 0, 0]
print(ys)
ys[1:1] = range(2)
del ys[0:2]
print(ys)
zs = list(range(10))
del zs[::3]
print(zs)
try:
    zs[::2] = [1]
except ValueError as e:
    print("错误：", e)

# ===== 字面量中的展开 =====
a1 = [1, 2]
d1 = {"x": 1, "y": 2}
print([*a1, *range(3), 9], {*a1, 3}, {**d1, "y": 20, "z": 30})

# ===== __repr__ =====
class Q:
    v: int
    def __repr__(self) -> str:
        return f"Q({self.v})"

class Q2(Q):
    def __str__(self) -> str:
        return f"Q2 的值是 {self.v}"

struct V:
    a: float
    def __repr__(self) -> str:
        return f"<{self.a}>"

qs: list[Q] = [Q(1), Q2(2)]
print(Q(0), qs, str(qs[1]), repr(qs[1]), f"{qs[1]!r}", V(1.5), [V(2.0)])

# ===== 其它 =====
print(*a1, sep=", ")
print('-' * 10, 3 * '=')

class Bag:
    items: list[int] = []
    def __len__(self) -> int:
        return len(self.items)
print(bool(Bag()), bool([1]), null as str?, [1, 2] as any)

# 结构体中在条件、return、推导式里调用修改 self 的方法
struct Counter:
    n: int
    def inc(self) -> bool:
        self.n += 1
        return true
    def twice(self) -> bool:
        if self.inc():
            return self.inc()
        return false
    def many(self) -> list[bool]:
        return [self.inc() for _ in range(3)]

ct = Counter(0)
ct.twice()
ct.many()
print(ct.n)
