# @cache / @lru_cache 装饰器与 functools 模块
from functools import cache, reduce, cmp_to_key
import functools

@cache
def fib(n: int) -> int:
    return n if n < 2 else fib(n - 1) + fib(n - 2)

calls = 0
@lru_cache(maxsize=2)
def square(x: int) -> int:
    global calls
    calls += 1
    return x * x

@lru_cache(maxsize=None)
def grid_paths(r: int, c: int) -> int:
    if r == 0 or c == 0:
        return 1
    return grid_paths(r - 1, c) + grid_paths(r, c - 1)

@cache
def edit(a: str, b: str) -> int:
    if a == "":
        return len(b)
    if b == "":
        return len(a)
    if a[0] == b[0]:
        return edit(a[1:], b[1:])
    return 1 + min(edit(a[1:], b), edit(a, b[1:]), edit(a[1:], b[1:]))

def outer(k: int) -> int:
    @cache
    def ways(n: int) -> int:
        if n < 0:
            return 0
        if n == 0:
            return 1
        return sum(ways(n - s) for s in range(1, k + 1))
    return ways(30)


print(fib(90), grid_paths(16, 16), edit("kitten", "sitting"), edit("intention", "execution"), outer(3))

for x in [1, 2, 1, 3, 1, 2]:
    square(x)
print(calls)

@cache
def boom(n: int) -> int:
    if n > 2:
        raise ValueError(f"太大了：{n}")
    return n
print(boom(1))
try:
    print(boom(5))
except ValueError as e:
    print("错误：", e)
print(boom(1))

print(reduce((a, b) => a * b, [1, 2, 3, 4, 5]), reduce((a, b) => a + b, [1, 2], 100), functools.reduce(max, [3, 9, 2]))
def by_len_then_rev(a: str, b: str) -> int:
    if len(a) != len(b):
        return len(a) - len(b)
    return -1 if a > b else (1 if a < b else 0)
print(sorted(["bb", "a", "ccc", "ab", "c"], key=cmp_to_key(by_len_then_rev)))
try:
    reduce((a, b) => a + b, list[int]())
except TypeError as e:
    print("错误：", e)
