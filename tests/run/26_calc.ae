# calc 模块 + 带绑定变量的 LaTeX：求和、连乘、极限、积分、矩阵、分段
import sym
import calc
import latex
import math

x = sym.var("x")
n = sym.var("n")
k = sym.var("k")

print("== 求和 ==")
print(sym.sum_expr("k", sym.num(1.0), n, k))
print(latex.sum_latex(r"\sum_{k=1}^{n} k"))
print(latex.sum_latex(r"\sum_{k=1}^{n} k^2"))
print(latex.sum_latex(r"\sum_{k=1}^{n} k^3"))
print(latex.sum_latex(r"\sum_{k=1}^{n} \left(3k + 1\right)"))
print(latex.sum_latex(r"\sum_{k=0}^{n} 2^k"))
print(latex.sum_latex(r"\sum_{k=0}^{\infty} \frac{1}{2^k}"))
print(latex.sum_latex(r"\sum_{k=1}^{100} k"))
print(sym.evaluate(latex.parse(r"\sum_{k=1}^{5} k^2"), {}))

print("== 连乘 ==")
print(latex.product_latex(r"\prod_{k=1}^{n} 3"))
print(latex.product_latex(r"\prod_{k=1}^{5} k"))
print(latex.product_latex(r"\prod_{k=1}^{n} 2^k"))
print(latex.to_latex(latex.parse(r"\prod_{i=1}^{n} \frac{1}{i}")))

print("== 极限 ==")
print(latex.to_latex(latex.parse(r"\lim_{x \to 0} \frac{\sin x}{x}")))
print(latex.limit_latex(r"\lim_{x \to 0} \frac{\sin x}{x}"))
print(latex.limit_latex(r"\lim_{x \to 0} \frac{1 - \cos x}{x^2}"))
print(latex.limit_latex(r"\lim_{x \to \infty} \frac{2x + 1}{x + 3}"))
print(latex.limit_latex(r"\lim_{x \to \infty} \left(1 + \frac{1}{x}\right)^x"))
print(latex.limit_latex(r"\lim_{x \to 0^{+}} \frac{1}{x}"))
print(latex.limit_latex(r"\lim_{x \to 1} \frac{x^2 - 1}{x - 1}"))

print("== 积分 ==")
print(latex.to_latex(latex.parse(r"\int_0^1 x^2 \, dx")))
print(latex.to_latex(latex.parse(r"\int x \, dx")))
print(latex.integrate_latex(r"\int x^2 + 3x \, dx"))
print(latex.integrate_latex(r"\int \frac{1}{x} \, dx"))
print(latex.integrate_latex(r"\int e^{2x} \, dx"))
print(latex.integrate_latex(r"\int \sin 2x \, dx"))
print(latex.integrate_latex(r"\int x e^x \, dx"))
print(latex.integrate_latex(r"\int \frac{1}{1 + x^2} \, dx"))
print(latex.definite_latex(r"\int_0^1 x^2 \, dx"))
print(latex.definite_latex(r"\int_0^{\pi} \sin x \, dx"))
print(latex.definite_latex(r"\int_0^1\int_0^1 x y \, dx \, dy"))

print("== 矩阵 ==")
m = latex.parse(r"\begin{pmatrix} 1 & 2 \\ 3 & 4 \end{pmatrix}")
print(m)
print(sym.shape(m))
print(latex.to_latex(m))
print(calc.determinant(m))
print(calc.trace(m))
print(latex.to_latex(calc.transpose(m)))
print(latex.to_latex(calc.inverse(m)))
print(latex.to_latex(calc.matmul(m, calc.identity(2))))
print(latex.to_latex(calc.scale(sym.num(2.0), m)))
print(calc.determinant(latex.parse(r"\begin{vmatrix} 2 & 0 & 1 \\ 1 & 3 & 2 \\ 1 & 1 & 1 \end{vmatrix}")))

print("== 分段 ==")
f = latex.parse(r"\begin{cases} x & x \ge 0 \\ -x & x < 0 \end{cases}")
print(f)
print(latex.to_latex(f))
print(sym.evaluate(f, {"x": -4.0}))
print(sym.evaluate(f, {"x": 3.0}))
print(latex.parse(r"\begin{cases} 1 & x > 0 \\ 0 & \text{otherwise} \end{cases}"))

print("== 与别的运算配合 ==")
print(latex.to_latex(sym.diff(latex.parse(r"\int_0^x t^2 \, dt"), "x")))
print(latex.to_latex(sym.subs(latex.parse(r"\sum_{k=1}^{n} x k"), {"x": sym.var("k")})))
print(sym.vars_of(latex.parse(r"\sum_{k=1}^{n} x k")))
g = sym.compile_expr(latex.parse(r"\sum_{k=1}^{4} x k"), ["x"])
print(g([3.0]))
