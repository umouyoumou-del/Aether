# calc 模块 + 带绑定变量的 LaTeX：求和、连乘、极限、积分、矩阵、分段
import sym
import calc
import latex
import math

x = sym.var("x")
n = sym.var("n")
k = sym.var("k")

print("== 求和 ==")
print(sym.sum_expr("k", sym.num(1.0), n, k))
print(latex.sum_latex(r"\sum_{k=1}^{n} k"))
print(latex.sum_latex(r"\sum_{k=1}^{n} k^2"))
print(latex.sum_latex(r"\sum_{k=1}^{n} k^3"))
print(latex.sum_latex(r"\sum_{k=1}^{n} \left(3k + 1\right)"))
print(latex.sum_latex(r"\sum_{k=0}^{n} 2^k"))
print(latex.sum_latex(r"\sum_{k=0}^{\infty} \frac{1}{2^k}"))
print(latex.sum_latex(r"\sum_{k=1}^{100} k"))
print(sym.evaluate(latex.parse(r"\sum_{k=1}^{5} k^2"), {}))

print("== 连乘 ==")
print(latex.product_latex(r"\prod_{k=1}^{n} 3"))
print(latex.product_latex(r"\prod_{k=1}^{5} k"))
print(latex.product_latex(r"\prod_{k=1}^{n} 2^k"))
print(latex.to_latex(latex.parse(r"\prod_{i=1}^{n} \frac{1}{i}")))

print("== 极限 ==")
print(latex.to_latex(latex.parse(r"\lim_{x \to 0} \frac{\sin x}{x}")))
print(latex.limit_latex(r"\lim_{x \to 0} \frac{\sin x}{x}"))
print(latex.limit_latex(r"\lim_{x \to 0} \frac{1 - \cos x}{x^2}"))
print(latex.limit_latex(r"\lim_{x \to \infty} \frac{2x + 1}{x + 3}"))
print(latex.limit_latex(r"\lim_{x \to \infty} \left(1 + \frac{1}{x}\right)^x"))
print(latex.limit_latex(r"\lim_{x \to 0^{+}} \frac{1}{x}"))
print(latex.limit_latex(r"\lim_{x \to 1} \frac{x^2 - 1}{x - 1}"))

print("== 积分 ==")
print(latex.to_latex(latex.parse(r"\int_0^1 x^2 \, dx")))
print(latex.to_latex(latex.parse(r"\int x \, dx")))
print(latex.integrate_latex(r"\int x^2 + 3x \, dx"))
print(latex.integrate_latex(r"\int \frac{1}{x} \, dx"))
print(latex.integrate_latex(r"\int e^{2x} \, dx"))
print(latex.integrate_latex(r"\int \sin 2x \, dx"))
print(latex.integrate_latex(r"\int x e^x \, dx"))
print(latex.integrate_latex(r"\int \frac{1}{1 + x^2} \, dx"))
print(latex.definite_latex(r"\int_0^1 x^2 \, dx"))
print(latex.definite_latex(r"\int_0^{\pi} \sin x \, dx"))
print(latex.definite_latex(r"\int_0^1\int_0^1 x y \, dx \, dy"))

print("== 矩阵 ==")
m = latex.parse(r"\begin{pmatrix} 1 & 2 \\ 3 & 4 \end{pmatrix}")
print(m)
print(sym.shape(m))
print(latex.to_latex(m))
print(calc.determinant(m))
print(calc.trace(m))
print(latex.to_latex(calc.transpose(m)))
print(latex.to_latex(calc.inverse(m)))
print(latex.to_latex(calc.matmul(m, calc.identity(2))))
print(latex.to_latex(calc.scale(sym.num(2.0), m)))
print(calc.determinant(latex.parse(r"\begin{vmatrix} 2 & 0 & 1 \\ 1 & 3 & 2 \\ 1 & 1 & 1 \end{vmatrix}")))

print("== 分段 ==")
f = latex.parse(r"\begin{cases} x & x \ge 0 \\ -x & x < 0 \end{cases}")
print(f)
print(latex.to_latex(f))
print(sym.evaluate(f, {"x": -4.0}))
print(sym.evaluate(f, {"x": 3.0}))
print(latex.parse(r"\begin{cases} 1 & x > 0 \\ 0 & \text{otherwise} \end{cases}"))

print("== 与别的运算配合 ==")
print(latex.to_latex(sym.diff(latex.parse(r"\int_0^x t^2 \, dt"), "x")))
print(latex.to_latex(sym.subs(latex.parse(r"\sum_{k=1}^{n} x k"), {"x": sym.var("k")})))
print(sym.vars_of(latex.parse(r"\sum_{k=1}^{n} x k")))
g = sym.compile_expr(latex.parse(r"\sum_{k=1}^{4} x k"), ["x"])
print(g([3.0]))

print("== 高次幂和与等差乘等比 ==")
print(latex.sum_latex(r"\sum_{k=1}^{n} k^5"))
print(latex.sum_latex(r"\sum_{k=0}^{n} k 2^k"))
print(latex.sum_latex(r"\sum_{k=0}^{\infty} k \left(\frac{1}{2}\right)^k"))
print(sym.evaluate(calc.sum(sym.sum_expr("k", sym.num(0.0), sym.num(5.0),
      sym.mul(sym.var("k"), sym.power(sym.num(2.0), sym.var("k"))))), {}))

print("== 泰勒展开 ==")
print(latex.taylor_latex(r"e^x", "x", 0.0, 5))
print(latex.taylor_latex(r"\sin x", "x", 0.0, 7))
print(latex.taylor_latex(r"\frac{1}{x}", "x", 1.0, 3))
print(latex.taylor_latex(r"\sqrt{1+x}", "x", 0.0, 3))

print("== 洛必达与振荡 ==")
print(latex.limit_latex(r"\lim_{x \to 0} \frac{e^x - 1 - x}{x^2}"))
print(latex.limit_latex(r"\lim_{x \to 0} \frac{\tan x - x}{x^3}"))
print(latex.limit_latex(r"\lim_{x \to 1} \frac{x^3 - 1}{x^2 - 1}"))
try:
    latex.limit_latex(r"\lim_{x \to 0} \sin\left(\frac{1}{x}\right)")
    print("振荡没有被发现")
except calc.CalcError:
    print("振荡：极限不存在")

print("== 三角幂与换元积分 ==")
print(latex.integrate_latex(r"\int \sin^3 x \, dx"))
print(latex.integrate_latex(r"\int \sin^2 x \cos^3 x \, dx"))
print(latex.integrate_latex(r"\int \cos^4 x \, dx"))
print(latex.integrate_latex(r"\int x e^{x^2} \, dx"))
print(latex.integrate_latex(r"\int \frac{x}{1+x^2} \, dx"))
print(latex.integrate_latex(r"\int x \ln x \, dx"))
print(latex.integrate_latex(r"\int \frac{1}{\sqrt{1-x^2}} \, dx"))
print(latex.integrate_latex(r"\int \frac{1}{x^2+2x+5} \, dx"))
print(latex.definite_latex(r"\int_0^{\pi/2} \sin^3 x \, dx"))
print(latex.definite_latex(r"\int_0^1 x \ln x \, dx"))

print("== 偏导 ==")
print(latex.to_latex(latex.parse(r"\frac{\partial}{\partial x} x^2 y")))
print(latex.to_latex(latex.parse(r"\frac{\partial^2}{\partial x \partial y} x^2 y^3")))
print(latex.to_latex(latex.parse(r"\frac{d}{dx} \sin x")))

print("== 解方程 ==")
print(calc.roots(sym.add(x ** 2, sym.num(-4.0)), "x"))
print(calc.roots(sym.add(sym.power(x, sym.num(3.0)), sym.add(sym.mul(sym.num(-3.0), x), sym.num(2.0))), "x"))
print(calc.roots(sym.add(x ** 2, sym.num(1.0)), "x"))
print(latex.solve_latex(r"x^4 - 5x^2 + 4 = 0", "x"))
print(calc.solve_linear(
    sym.matrix([[sym.num(2.0), sym.num(1.0), sym.num(-1.0)],
                [sym.num(-3.0), sym.num(-1.0), sym.num(2.0)],
                [sym.num(-2.0), sym.num(1.0), sym.num(2.0)]]),
    sym.matrix([[sym.num(8.0)], [sym.num(-11.0)], [sym.num(-3.0)]])))

print("== 大矩阵数值行列式 ==")
big = sym.matrix([[sym.num(2.0), sym.num(0.0), sym.num(0.0), sym.num(0.0), sym.num(0.0), sym.num(1.0)],
                  [sym.num(0.0), sym.num(3.0), sym.num(0.0), sym.num(0.0), sym.num(0.0), sym.num(2.0)],
                  [sym.num(0.0), sym.num(0.0), sym.num(4.0), sym.num(0.0), sym.num(0.0), sym.num(3.0)],
                  [sym.num(0.0), sym.num(0.0), sym.num(0.0), sym.num(5.0), sym.num(0.0), sym.num(4.0)],
                  [sym.num(0.0), sym.num(0.0), sym.num(0.0), sym.num(0.0), sym.num(6.0), sym.num(5.0)],
                  [sym.num(1.0), sym.num(1.0), sym.num(1.0), sym.num(1.0), sym.num(1.0), sym.num(1.0)]])
print(calc.determinant(big))

print("== 不定函数：链式法则与数值核对 ==")
# 把 f 换成具体函数后，符号导数与数值导数一致（f(e^x) 对 x 求导）
fe = latex.parse(r"f'(e^x) e^x")
concrete = sym.subs_fn(fe, "f", sym.fn("sin", sym.var("u")), ["u"])
hh = 1e-6
num = (math.sin(math.exp(0.7 + hh)) - math.sin(math.exp(0.7 - hh))) / (2.0 * hh)
print(latex.to_latex(concrete), "|", sym.evaluate(concrete, {"x": 0.7}), "|", num)
# 多元链式法则：d/dt f(x(t), y(t)) = f_1 x'(t) + f_2 y'(t)，x = t^2、y = sin t，f = u v
chain = latex.parse(r"\frac{d}{dt} f(t^2, \sin t)")
chain = sym.subs_fn(chain, "f", sym.var("u") * sym.var("v"), ["u", "v"])
num2 = ((0.7 + hh) ** 2 * math.sin(0.7 + hh) - (0.7 - hh) ** 2 * math.sin(0.7 - hh)) / (2.0 * hh)
print(latex.to_latex(chain), "|", sym.evaluate(chain, {"t": 0.7}), "|", num2)
# 二元：f(x y) 对 x 的偏导 = f_1(x y)·y，换成 f = u^2 得 2 x y^2
fe2 = latex.parse(r"\frac{\partial f(x y)}{\partial x}")
print(latex.to_latex(sym.subs_fn(fe2, "f", sym.var("u") ** 2, ["u"])))
# 不定函数的极限：f(x)/x 在 x -> 0 处由 f'(0) 决定；换成 f = sin u 后是 cos(0) = 1
quo = latex.parse(r"\frac{f(x)}{x}")
print(calc.limit_at(sym.subs_fn(quo, "f", sym.fn("sin", sym.var("u")), ["u"]), "x", sym.num(0.0)))
