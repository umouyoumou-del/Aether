# 类、继承、抽象类、接口、属性、运算符重载、静态成员
abstract class Shape:
    name: str = "shape"

    abstract def area(self) -> float

    def describe(self) -> str:
        return f"{self.name} 面积 {self.area():.2f}"

class Circle(Shape):
    r: float

    def __init__(self, r: float):
        self.name = "圆"
        self.r = r

    override def area(self) -> float:
        return 3.14159 * self.r * self.r

class Rect(Shape):
    w: float
    h: float

    def __init__(self, w: float, h: float):
        self.name = "矩形"
        self.w = w
        self.h = h

    override def area(self) -> float:
        return self.w * self.h

class Square(Rect):
    def __init__(self, side: float):
        super().__init__(side, side)
        self.name = "正方形"

    override def describe(self) -> str:
        return "★ " + super().describe()

shapes: list[Shape] = [Circle(1.0), Rect(2.0, 3.0), Square(2.0)]
for s in shapes:
    print(s.describe())
total = sum(s.area() for s in shapes)
print(f"总面积 {total:.3f}")
print([s.name for s in shapes if s is Rect])

interface Greeter:
    def greet(self) -> str

class Dog:
    name: str
    def greet(self) -> str:
        return f"汪！我是 {self.name}"

class Robot:
    model: str = "R2"
    def greet(self) -> str:
        return "哔哔 " + self.model

def welcome(g: Greeter):
    print(g.greet())

welcome(Dog("旺财"))
welcome(Robot())
greeters: list[Greeter] = [Dog("小黑"), Robot("C3PO")]
for g in greeters:
    welcome(g)

class Account:
    owner: str
    _balance: float = 0.0
    static count: int = 0

    def __init__(self, owner: str, balance: float = 0.0):
        self.owner = owner
        self._balance = balance
        Account.count += 1

    prop balance -> float:
        return self._balance

    prop doubled -> float:
        get:
            return self._balance * 2
        set(v):
            self._balance = v / 2

    def deposit(self, amount: float) -> Account:
        self._balance += amount
        return self

    def __str__(self) -> str:
        return f"Account({self.owner}, {self._balance})"

    static def create(owner: str) -> Account:
        return Account(owner, 100.0)

a = Account("小明")
a.deposit(50).deposit(25)
print(a, a.balance, a.doubled)
a.doubled = 1000.0
print(a.balance)
b = Account.create("小红")
print(b, Account.count)

struct Vec:
    x: float
    y: float

    def __add__(self, o: Vec) -> Vec:
        return Vec(self.x + o.x, self.y + o.y)

    def __mul__(self, k: float) -> Vec:
        return Vec(self.x * k, self.y * k)

    def __rmul__(self, k: float) -> Vec:
        return self * k

    def __neg__(self) -> Vec:
        return Vec(-self.x, -self.y)

    def length(self) -> float:
        return (self.x * self.x + self.y * self.y) ** 0.5

    def scale(self, k: float):
        self.x *= k
        self.y *= k

v = Vec(3.0, 4.0)
w = v + Vec(1.0, 1.0)
print(v, w, v * 2.0, 2.0 * v, -v, v.length())
print(v == Vec(3.0, 4.0), v == w)
v.scale(10.0)
print(v)
pts = {Vec(0.0, 0.0): "原点", Vec(1.0, 0.0): "x"}
print(pts[Vec(0.0, 0.0)])

class Point:
    x: int
    y: int = 0

p = Point(1)
q = Point(x=2, y=3)
print(p, q, p.x + q.y)

class Node:
    value: int
    next: Node? = null

n = Node(1, Node(2, Node(3)))
cur: Node? = n
vals: list[int] = []
while cur != null:
    vals.append(cur.value)
    cur = cur.next
print(vals)

# 常量、字段默认值、参数默认值中构造对象（构造函数的签名需要提前确定）
class Pt:
    x: int
    y: int = 0
const ORIGIN = Pt(0)
def norm1(p: Pt = ORIGIN) -> int:
    return abs(p.x) + abs(p.y)
class Seg:
    a: Pt = Pt(1, 2)
    b = Pt(3)
print(ORIGIN, norm1(), norm1(Pt(-3, 4)), Seg().a, Seg().b, Seg(Pt(9)).a)
