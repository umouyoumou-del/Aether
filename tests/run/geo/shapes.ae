# geo.shapes 模块
import math

const UNIT: float = 1.0
_secret = 42
created = 0

struct Point:
    x: float
    y: float

    def dist(self, o: Point) -> float:
        return math.hypot(self.x - o.x, self.y - o.y)

def origin() -> Point:
    created += 1
    return Point(0.0, 0.0)

def area_of_circle(r: float) -> float:
    return math.pi * r * r
