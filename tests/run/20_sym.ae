# sym 模块：符号数学（化简、展开、求导、求值、编译、方程、积分）
import sym
import math

x = sym.var("x")
y = sym.var("y")
a = sym.var("a")
b = sym.var("b")

# ===== 构造与打印 =====
print(x + y, 2 * x, x * y, x ** 2, -x, x - y, x / 2)
print(x + 1, 1 + x, 3 - x, x * 2.5, 2.5 * x, x ** 3)

# 化简的单位元与零元
print(x + 0, x * 1, x * 0, x ** 1, x ** 0, (2 + 3) * x, x + x + x)

# 合并同类项与同底数的幂
print(2 * x + 3 * x - x, x * x * x, x ** 2 * x ** 3, x ** 2 * x ** -2)

# ===== 展开 =====
print(sym.expand((x + 1) ** 2))
print(sym.expand((a + b) ** 2))
print(sym.expand((a + b) ** 3))
print(sym.expand((a + b) * (a - b)))
print(sym.expand((x + 1) * (x + 2) * (x + 3)))
print(sym.expand(x * (y + 2) + y * (x + 1)))

# ===== 求导 =====
print(sym.diff(x ** 3 + 2 * x, "x"))
print(sym.diff(x ** 2 + 3 * x + 1, "x"))
print(sym.diff(x * x, "x"))
print(sym.diff(x * y, "x"), sym.diff(x * y, "y"))
print(sym.diff(sym.fn("sin", x), "x"))
print(sym.diff(sym.fn("sin", x ** 2), "x"))
print(sym.diff(x * sym.fn("sin", x), "x"))
print(sym.diff(sym.fn("exp", 2 * x), "x"))
print(sym.diff(sym.fn("log", x), "x"))
print(sym.diff(x / (x + 1), "x"))

# 不可微的表达式在求导时被拒绝
try:
    sym.diff(sym.fn("abs", x), "x")
except TypeError as e:
    print("拒绝求导：", e)

# ===== 不定函数的符号微分 =====
uf = sym.ufunc("f", [x])
ug = sym.ufunc("g", [x, y])
print("== 不定函数 ==")
print(sym.diff(uf, "x"), "|", sym.diff(uf, "y"))
print(sym.diff(ug, "x"), "|", sym.diff(ug, "y"))
# 混合偏导与求导顺序无关：指标按升序存放，所以两者是同一个节点
print(sym.diff(sym.diff(ug, "x"), "y"), "|", sym.diff(sym.diff(ug, "y"), "x"))
print(sym.equals(sym.diff(sym.diff(ug, "x"), "y"), sym.diff(sym.diff(ug, "y"), "x")))
# 链式法则、乘积法则、商法则
print(sym.diff(uf * uf, "x"))
print(sym.diff(uf / ug, "x"))
print(sym.diff(sym.ufunc("f", [x ** 2 + y]), "x"))
print(sym.diff(sym.ufunc("h", [x, y, a]), "y"))
print(sym.diff(x * ug + uf, "x"))
print(sym.expand(sym.diff((uf + ug) ** 2, "x")))
# 高阶
print(sym.diff(sym.diff(uf, "x"), "x"))
print(sym.diff(sym.diff(sym.diff(uf, "x"), "x"), "x"))
# 偏导记号再对自变量求导
print(sym.diff(sym.df_expr("g", [x, y], [0.0]), "x"))
# 代入：自变量换掉、指标不动
print(sym.subs(sym.diff(ug, "x"), {"x": sym.num(3.0)}))
print(sym.subs(sym.diff(ug, "x"), {"x": y, "y": x}))
print(sym.vars_of(sym.diff(ug, "x") + uf))
# 把函数换成具体表达式：偏导记号自动换成相应偏导
print(sym.subs_fn(uf * uf + sym.diff(uf, "x"), "f", x ** 3, ["x"]))
print(sym.subs_fn(sym.diff(ug, "x") + sym.diff(ug, "y"), "g", x * sym.fn("sin", y), ["x", "y"]))
print(sym.subs_fn(sym.diff(uf, "x"), "f", sym.fn("exp", x), ["x"]))
# 哑变量捕获避免：函数式里的 t 与外面求和的 t 同名时，求和变量换名
kk = sym.var("k")
s2 = sym.sum_expr("t", sym.num(1.0), sym.num(3.0), sym.ufunc("h", [kk]) * sym.var("t"))
print(sym.subs_fn(s2, "h", sym.var("t") + x, ["t"]))
# 不定函数没有定义，不能数值求值或编译
try:
    sym.evaluate(uf, {"x": 1.0})
except ValueError as e:
    print(e.message)
try:
    sym.compile_expr(uf, ["x"])
except ValueError as e:
    print(e.message)
# 构造时的检查
try:
    sym.ufunc("sin", [x, y])
except ValueError as e:
    print(e.message)
try:
    sym.ufunc("f(x)", [x])
except ValueError as e:
    print(e.message)
try:
    sym.df_expr("f", [x], [1.0])
except ValueError as e:
    print(e.message)

# ===== 恒等检查 =====

print(sym.equals((a + b) ** 2, a ** 2 + 2 * a * b + b ** 2))
print(sym.equals((a + b) * (a - b), a ** 2 - b ** 2))
print(sym.equals(sym.fn("sin", x) ** 2 + sym.fn("cos", x) ** 2, sym.num(1.0)))
print(sym.equals(x + 1, x + 2))
print(sym.difference((x + 1) ** 2, x ** 2 + 2 * x + 1))

# ===== 代入与求值 =====
f = (x + y) ** 2
print(sym.subs(f, {"y": sym.num(1.0)}))
print(sym.evaluate(f, {"x": 2.0, "y": 3.0}))
print(sym.evaluate(sym.fn("sin", x) + sym.fn("cos", x), {"x": 0.0}))
print(sym.vars_of(x * y + sym.fn("sin", x) + a))

try:
    sym.evaluate(x, {})
except KeyError as e:
    print("缺少取值：", e)

# ===== 编译成闭包 =====
g = sym.compile_expr(f, ["x", "y"])
print(g([2.0, 3.0]), g([1.0, 1.0]))
h = sym.compile_expr(sym.fn("exp", x) * sym.fn("sin", x), ["x"])
env: dict[str, float] = {"x": 0.5}
print(f"{h([0.5]):.10f}", f"{sym.evaluate(sym.fn("exp", x) * sym.fn("sin", x), env):.10f}")

# 求导结果与数值差商一致
d = sym.diff(x ** 4 + sym.fn("sin", x), "x")
dc = sym.compile_expr(d, ["x"])
env2: dict[str, float] = {"x": 1.3}
expected = 4.0 * 1.3 ** 3 + sym.evaluate(sym.fn("cos", x), env2)
print(f"{dc([1.3]):.8f}", f"{expected:.8f}")

# ===== 方程 =====
r = sym.solve_quadratic(sym.num(1.0), sym.num(-3.0), sym.num(2.0))
print(r[0], r[1])
r2 = sym.solve_quadratic(sym.num(1.0), sym.num(0.0), sym.num(-4.0))
print(r2[0], r2[1])

try:
    sym.solve_quadratic(sym.num(1.0), sym.num(0.0), sym.num(1.0))
except ValueError as e:
    print("无实根：", e)

# ===== 数值积分 =====
q = sym.compile_expr(x ** 2, ["x"])
print(f"{sym.integrate_numeric(q, 0.0, 1.0, 1000):.10f}")
sine = sym.compile_expr(sym.fn("sin", x), ["x"])
print(f"{sym.integrate_numeric(sine, 0.0, math.pi, 1000):.6f}")
