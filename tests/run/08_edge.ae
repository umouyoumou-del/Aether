# 整数运算边界
print(2 ** 62, -(2 ** 63) == -9223372036854775807 - 1, 7 // 2, -7 // 2, 7 % 3, -7 % 3)
print(10 / 4, 10 // 4, 10.0 // 4, 10 % 4.5, 2 ** 0.5)
print(0x10 | 0b11, 6 & 3, 6 ^ 3, ~5, 1 << 10, 1024 >> 3)
# 集合与字典操作
words = ["a", "b", "a", "c", "b", "a"]
freq: dict[str, int] = {}
for w in words:
    freq[w] = freq.get(w, 0) + 1
print(freq, sorted(freq.items(), key=kv => -kv[1]))
print({k: v for k, v in freq.items() if v > 1})
print(set(words), len(set(words)), sorted(set(words)))
