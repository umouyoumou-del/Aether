# 可变参数与关键字参数
def total(*nums: int, scale: int = 1) -> int:
    s = 0
    for n in nums:
        s += n
    return s * scale

print(total(), total(1, 2, 3), total(1, 2, scale=10), total(*[4, 5]))
def greet(name: str, greeting: str = "你好", punct: str = "！") -> str:
    return greeting + "，" + name + punct

print(greet("小明"), greet("Tom", greeting="Hi", punct="!"), greet(punct="~", name="猫"))
# 下标、in、长度协议
class Grid:
    w: int
    h: int
    cells: list[int] = []

    def __init__(self, w: int, h: int):
        self.w = w
        self.h = h
        self.cells = [0] * (w * h)

    def __getitem__(self, p: (int, int)) -> int:
        return self.cells[p[1] * self.w + p[0]]

    def __setitem__(self, p: (int, int), v: int):
        self.cells[p[1] * self.w + p[0]] = v

    def __len__(self) -> int:
        return self.w * self.h

    def __contains__(self, v: int) -> bool:
        return v in self.cells

    def __iter__(self) -> iter[int]:
        for c in self.cells:
            yield c

g = Grid(3, 2)
g[(1, 1)] = 7
g[(0, 0)] += 2
print(g[(1, 1)], g[(0, 0)], len(g), 7 in g, 9 in g, list(g))
if g:
    print("非空网格")
# is 与 as、窄化
class Animal:
    name: str
class Dog(Animal):
    def bark(self) -> str:
        return self.name + " 汪"
class Cat(Animal):
    pass

pets: list[Animal] = [Dog("旺财"), Cat("咪咪")]
for p in pets:
    if p is Dog:
        print(p.bark())
    else:
        print(p.name, "不会叫")
    d = p as? Dog
    print(d?.bark() ?? "不是狗")
val: any = 42
if val is int:
    print("整数加一：", val + 1)
print((val as int) * 2)
try:
    s = val as str
except TypeError as e:
    print("转换失败:", e)
# 嵌套函数与闭包修改外层变量
def outer() -> int:
    acc = 0
    def add(n: int):
        acc += n
    for i in range(5):
        add(i)
    return acc
print(outer())
# 递归
def hanoi(n: int, a: str, b: str, c: str, moves: list[str]):
    if n == 0:
        return
    hanoi(n - 1, a, c, b, moves)
    moves.append(f"{a}->{c}")
    hanoi(n - 1, b, a, c, moves)
mv: list[str] = []
hanoi(3, "A", "B", "C", mv)
print(len(mv), mv[:3])
# 结构体在列表中的可变方法
struct Counter:
    n: int = 0
    def inc(self):
        self.n += 1
cs = [Counter(), Counter()]
cs[0].inc()
cs[0].inc()
cs[1].inc()
print(cs[0].n, cs[1].n)
c1 = Counter()
c2 = c1
c2.inc()
print("值语义:", c1.n, c2.n)
# 类是引用语义
class Box:
    v: int = 0
b1 = Box()
b2 = b1
b2.v = 9
print("引用语义:", b1.v)
