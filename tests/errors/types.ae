x: int = "hello"              # 错误: 类型不匹配
y = 5
y = "five"                    # 错误: 类型不匹配，需要 int，实际是 str
z = undefined_name + 1        # 错误: 未定义的名字 'undefined_name'
s = "a" + 1                   # 错误: 不能把 str 和 int 相加
n: int = 3.7                  # 错误: 类型不匹配
xs = []                       # 错误: 无法推断空列表的元素类型
f = 3.14
i: int = f                    # 错误: 浮点数不会隐式转换为整数
def add(a: int, b: int) -> int:
    return a + b
add(1)                        # 错误: 缺少参数 b
add(1, 2, 3)                  # 错误: 最多接受 2 个参数
add(1, c=2)                   # 错误: 没有名为 c 的参数
print(len(5))                 # 错误: 没有长度
const LIMIT = 10
LIMIT = 20                    # 错误: 不能给常量 LIMIT 赋值
if 1:                         # 错误: 条件需要 bool 类型
    pass
"abc".nope()                  # 错误: 没有方法 nope
q = None                      # 错误: 未定义的名字 'None'
t = True                      # 错误: 未定义的名字 'True'
