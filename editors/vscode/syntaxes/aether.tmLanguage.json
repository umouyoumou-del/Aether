{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aether",
  "scopeName": "source.aether",
  "patterns": [
    { "include": "#comment" },
    { "include": "#decorator" },
    { "include": "#declaration" },
    { "include": "#expression" }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.aether"
    },
    "decorator": {
      "match": "^\\s*(@)(\\w+)",
      "captures": {
        "1": { "name": "punctuation.definition.decorator.aether" },
        "2": { "name": "entity.name.function.decorator.aether" }
      }
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(def)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "storage.type.function.aether" },
            "2": { "name": "entity.name.function.aether" }
          }
        },
        {
          "match": "\\b(class|struct|interface|enum)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "storage.type.class.aether" },
            "2": { "name": "entity.name.type.class.aether" }
          }
        },
        {
          "match": "\\b(prop)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "storage.type.property.aether" },
            "2": { "name": "variable.other.property.aether" }
          }
        },
        {
          "match": "^(type)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*[\\[=])",
          "captures": {
            "1": { "name": "storage.type.alias.aether" },
            "2": { "name": "entity.name.type.alias.aether" }
          }
        },
        {
          "match": "^\\s*(test)\\s+(?=\")",
          "captures": { "1": { "name": "keyword.other.test.aether" } }
        }
      ]
    },
    "expression": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#fstring" },
        { "include": "#string" },
        { "include": "#char" },
        { "include": "#number" },
        {
          "match": "\\b(if|elif|else|while|for|in|break|continue|return|yield|try|except|finally|raise|with|go|defer|await|pass|assert|del|import|from|as)\\b",
          "name": "keyword.control.aether"
        },
        {
          "match": "^\\s*(match|case|select|default)\\b",
          "name": "keyword.control.aether"
        },
        {
          "match": "\\b(def|class|struct|interface|enum|extend|const|async|prop)\\b",
          "name": "storage.type.aether"
        },
        {
          "match": "\\b(static|abstract|override|global|nonlocal)\\b",
          "name": "storage.modifier.aether"
        },
        {
          "match": "\\b(and|or|not|is)\\b",
          "name": "keyword.operator.logical.aether"
        },
        {
          "match": "\\b(true|false|null)\\b",
          "name": "constant.language.aether"
        },
        {
          "match": "\\b(self|super)\\b",
          "name": "variable.language.aether"
        },
        {
          "match": "\\b(int|i8|i16|i32|i64|u8|u16|u32|u64|byte|float|f32|f64|bool|str|char|any|void|list|dict|set|chan|iter|fn)\\b",
          "name": "support.type.builtin.aether"
        },
        {
          "match": "\\b(print|input|len|range|enumerate|zip|sorted|reversed|sum|min|max|any|all|abs|round|divmod|repr|ord|chr|hex|bin|oct|open|type_name|isinstance|exit|gather|counter|count_from|repeat|map|filter)\\b(?=\\s*\\()",
          "name": "support.function.builtin.aether"
        },
        {
          "match": "\\b(Exception|ValueError|TypeError|IndexError|KeyError|ZeroDivisionError|NullError|RuntimeError|AssertionError|NotImplementedError|OverflowError|TimeoutError|ChannelClosedError|IOError|OSError|FileNotFoundError|FileExistsError|PermissionError|EOFError|JSONError|Task|Mutex|RWMutex|WaitGroup|AtomicInt|File)\\b",
          "name": "support.class.builtin.aether"
        },
        {
          "match": "\\b[A-Z][\\p{L}\\p{N}_]*\\b",
          "name": "entity.name.type.aether"
        },
        {
          "match": ":=|=>|->|\\?\\.|\\?\\?|\\*\\*=?|//=?|[-+*/%&|^]=?|<<=?|>>=?|==|!=|<=|>=|<|>|=|~|!",
          "name": "keyword.operator.aether"
        },
        {
          "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.call.aether" } }
        }
      ]
    },
    "number": {
      "patterns": [
        { "match": "\\b0[xX][0-9a-fA-F_]+\\b", "name": "constant.numeric.hex.aether" },
        { "match": "\\b0[bB][01_]+\\b", "name": "constant.numeric.binary.aether" },
        { "match": "\\b0[oO][0-7_]+\\b", "name": "constant.numeric.octal.aether" },
        { "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?\\b", "name": "constant.numeric.decimal.aether" }
      ]
    },
    "escape": {
      "match": "\\\\(u\\{[0-9a-fA-F]+\\}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|x[0-9a-fA-F]{2}|.)",
      "name": "constant.character.escape.aether"
    },
    "char": {
      "match": "'(\\\\.|\\\\u[0-9a-fA-F]{4}|\\\\u\\{[0-9a-fA-F]+\\}|[^'\\\\])'",
      "name": "constant.character.aether"
    },
    "string": {
      "patterns": [
        {
          "begin": "[rR]\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.triple.raw.aether"
        },
        {
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.triple.aether",
          "patterns": [{ "include": "#escape" }]
        },
        {
          "begin": "[rR]\"",
          "end": "\"",
          "name": "string.quoted.double.raw.aether"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.aether",
          "patterns": [{ "include": "#escape" }]
        }
      ]
    },
    "fstring": {
      "patterns": [
        {
          "begin": "(?:[fF][rR]?|[rR][fF])\"\"\"",
          "end": "\"\"\"",
          "name": "string.interpolated.triple.aether",
          "patterns": [{ "include": "#escape" }, { "include": "#interpolation" }]
        },
        {
          "begin": "(?:[fF][rR]?|[rR][fF])\"",
          "end": "\"",
          "name": "string.interpolated.aether",
          "patterns": [{ "include": "#escape" }, { "include": "#interpolation" }]
        }
      ]
    },
    "interpolation": {
      "patterns": [
        { "match": "\\{\\{|\\}\\}", "name": "constant.character.escape.aether" },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.aether" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.aether" } },
          "contentName": "meta.embedded.aether",
          "patterns": [
            { "match": "(![rs])?(:[^{}\"]*)?(?=\\})", "name": "storage.type.format.aether" },
            { "include": "#expression" }
          ]
        }
      ]
    }
  }
}
